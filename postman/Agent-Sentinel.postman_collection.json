    {
      "name": "Read saved log",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/logs/{{log_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Stored data matches', () => pm.expect(pm.response.json().data).to.deep.equal(JSON.parse(pm.collectionVariables.get('saved_data'))));"
            ]
          }
        }
      ],
      "response": []
    },
