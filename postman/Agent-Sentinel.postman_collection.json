{
  "info": {
    "name": "Agent Sentinel",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "log_id",
      "value": ""
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "request_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Readiness Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "01_read",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/logs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"timestamp\": \"2026-11-19T09:00:00+09:00\",\n  \"user_id\": \"user-demo\",\n  \"agent_id\": \"agent-demo\",\n  \"session_id\": \"{{session_id}}\",\n  \"request_id\": \"{{request_id}}\",\n  \"sequence_no\": 0,\n  \"tool_name\": \"db.query\",\n  \"action\": \"read\",\n  \"resource\": \"table:orders\",\n  \"status\": \"success\",\n  \"duration_ms\": 12,\n  \"metadata\": {\n    \"result_count\": 3,\n    \"transport\": \"http\",\n    \"resource_type\": \"table\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('session_id', pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('request_id', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { pm.collectionVariables.set('log_id', pm.response.json().data.log_id); pm.collectionVariables.set('saved_data', JSON.stringify(pm.response.json().data)); }"
            ]
          }
        }
      ],
      "response": []
    },
