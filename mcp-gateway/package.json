    "start": "node dist/index.js --transport stdio",
    "start:demo": "node dist/index.js --transport stdio --demo"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@bytebase/dbhub": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
