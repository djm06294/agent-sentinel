{
  "name": "agent-sentinel-mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "DBHub 앞단에서 MCP 메시지를 중계하는 Wrapper (Claude Code ↔ Wrapper ↔ DBHub)",
  "type": "module",
  "bin": {
    "agent-sentinel-mcp-gateway": "dist/index.js"
  },
  "scripts": {
